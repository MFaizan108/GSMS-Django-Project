# Copy this file to .env and fill in real values. Never commit the actual
# .env file. gsms/settings.py loads it automatically via python-dotenv (see
# load_dotenv() near the top of the file), so a local .env is enough in dev —
# in production you can still set real OS/container environment variables
# instead (systemd unit, Docker env, hosting platform's env config, etc.);
# they take the same effect and don't require a .env file to be present.

# A long, random, secret string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-real-random-secret-key

# Must be False in production.
DJANGO_DEBUG=False

# Comma-separated list of hostnames/domains this site is served from.
DJANGO_ALLOWED_HOSTS=yourstore.example.com,www.yourstore.example.com

# Leave DB_ENGINE unset (or anything other than "postgresql") to use SQLite, the default.
DB_ENGINE=postgresql
DB_NAME=gsms
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
